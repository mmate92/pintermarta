---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';

// The background used when a visitor has not picked a sketch:
// 'szinpad' (theatre), 'konyvespolc' (bookshelf) or 'konyvtar' (library hall).
const DEFAULT_THEME = 'szinpad';

interface Props { title?: string; }
const { title } = Astro.props;
const fullTitle = title ? `${title} – ${site.name}` : site.name;
---
<!doctype html>
<html lang="hu" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>
      try {
        // ?vazlat=konyvtar in the address picks a sketch and remembers it
        var q = new URLSearchParams(location.search).get('vazlat');
        if (q) localStorage.setItem('vazlat', q);
        var t = q || localStorage.getItem('vazlat');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#tartalom">Ugrás a tartalomhoz</a>
    <div class="scene" aria-hidden="true">
      <div class="boards"></div>
      <div class="curtain left"></div>
      <div class="curtain right"></div>
      <div class="valance"></div>
      <div class="shelves"></div>
      <div class="dim"></div>
      <div class="hall"></div>
      <div class="dusk"></div>
    </div>
    <div class="shell">
      <Header />
      <main id="tartalom" class="sheet">
        <slot />
      </main>
      <Footer />
    </div>
    <ThemeSwitcher />
    <Lightbox />
  </body>
</html>
